SECRET_KEY=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cybernexus?retryWrites=true&w=majority
MONGODB_DB_NAME=cybernexus
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
# Comma-separated list of allowed frontend origins (CORS).
# Production: set to your Vercel deployment URL(s).
CORS_ORIGINS=https://cybernexus-iota.vercel.app,http://localhost:3000
# For local dev, set NEXT_PUBLIC_API_BASE_URL=http://localhost:8000 in frontend/.env.local
